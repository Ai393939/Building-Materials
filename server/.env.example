# Скопируй этот файл в server/.env
# Локальный npm run start:dev ходит на localhost.
# docker compose подменяет DATABASE_URL и REDIS_URL на имена сервисов.

PORT=3000
NODE_ENV=development

DATABASE_URL=postgresql://buildmart:buildmart@localhost:5432/buildmart
DATABASE_SSL=false
REDIS_URL=redis://localhost:6379

JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5500

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
